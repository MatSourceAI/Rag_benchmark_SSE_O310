# Use your own authorized indexed corpus and provider settings.
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_DATABASE=
MILVUS_COLLECTION=
MILVUS_VECTOR_FIELD=emb_gemini
MILVUS_TEXT_FIELD=enriched_content
# Match your existing index; the study used IVF_FLAT.
MILVUS_INDEX_TYPE=IVF_FLAT
MILVUS_EF=64
MILVUS_NPROBE=16
MILVUS_METRIC_TYPE=COSINE
MILVUS_FILTER_EXPR=
# Independent choices; CLI flags override these two settings.
QUERY_MODE=none
RETRIEVAL_MODE=ann
# Hybrid requires a Milvus 2.5+ native BM25 function and sparse index.
MILVUS_SPARSE_FIELD=bm25_sparse
# Blank uses top_k for each branch; a value must be >= top_k.
HYBRID_CANDIDATE_K=
HYBRID_RRF_K=60
# Number of alternatives in addition to the original question.
MULTI_QUERY_COUNT=3
MULTI_QUERY_RRF_K=60
# Optional separate query model. Blank QUERY_MODEL reuses the answer generator
# including its provider and temperature. These fields apply only when set.
QUERY_MODEL=
QUERY_PROVIDER=openai_compatible
QUERY_BASE_URL=
QUERY_API_KEY=
QUERY_TEMPERATURE=0.0
# Optional. Must support the /rerank request used by components.py.
RERANK_MODEL=
RERANK_BASE_URL=
RERANK_API_KEY=
GENERATOR_MODEL=
GENERATOR_BASE_URL=
GENERATOR_API_KEY=
# google or openai_compatible; omit temperature for providers that reject it.
GENERATOR_PROVIDER=openai_compatible
GENERATOR_TEMPERATURE=0.3
# Optional online judge. All settings are release defaults, not recovered runs.
EVALUATOR_API_KEY=
EVALUATOR_MODEL=gemini-2.5-pro
EVALUATOR_TEMPERATURE=0.1
EVALUATOR_EMBEDDING_MODEL=gemini-embedding-001
EVALUATOR_METRIC_TIMEOUT=180
